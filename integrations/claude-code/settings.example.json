{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/repo/sema-agent/integrations/claude-code/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/repo/sema-agent/integrations/claude-code/session-note.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/repo/sema-agent/integrations/claude-code/session-end.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/repo/sema-agent/integrations/claude-code/subagent-note.sh"
          }
        ]
      }
    ]
  }
}